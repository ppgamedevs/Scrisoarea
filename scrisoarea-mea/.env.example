# Local Prisma CLI / sqlite file (used by `prisma generate` and `prisma db push`)
DATABASE_URL="file:./dev.db"

# Turso (libSQL) — required on Vercel
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=""

# Vercel Blob — injected automatically when a Blob store is connected
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_APP_URL="https://www.visuripehartie.ro"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# Google Analytics 4 measurement ID (gtag.js)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-CW42394DCZ"
CRON_SECRET=""

# Admin account (used by `npm run db:seed` and `npm run db:sync-admin`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL for auth callbacks (defaults to NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL="http://localhost:3000"

# Resend — required for verification & password-reset emails
# Get a key from https://resend.com (starts with re_)
RESEND_API_KEY=""
# Must use a verified domain in Resend, e.g.:
# EMAIL_FROM="Visuri pe hartie <noreply@your-verified-domain.ro>"
# Format required by Resend: email@domain.com  OR  Name <email@domain.com>
EMAIL_FROM="Visuri pe hartie <contact@visuripehartie.ro>"
CONTACT_EMAIL="contact@visuripehartie.ro"

# Stripe — https://dashboard.stripe.com/apikeys
# Sandbox keys (pk_test_ / sk_test_) for tests; replace with live keys in production after.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# Signing secret for https://www.visuripehartie.ro/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=""

NEXT_PUBLIC_ASSOCIATION_CUI="55406686"
ASSOCIATION_LEGAL_NAME="Asociatia pentru visuri si oportunitati"
# IBAN for Form 230 destination (required for a complete form)
ASSOCIATION_IBAN="RO22RNCB0280187121730001"
# Anul din Formularul 230 = anul în care s-au realizat veniturile (nu anul generării PDF)
FORM_230_FISCAL_YEAR="2026"
NEXT_PUBLIC_FORM_230_FISCAL_YEAR="2026"
FORM_230_DEFAULT_PERCENT="3.5"

# Sponsorizare companii / Formular 177 (OPANAF 3562/2024)
SPONSORSHIP_BENEFICIARY_NAME="Asociatia pentru visuri si oportunitati"
SPONSORSHIP_BENEFICIARY_CIF="55406686"
SPONSORSHIP_BENEFICIARY_IBAN="RO22RNCB0280187121730001"
SPONSORSHIP_BENEFICIARY_BANK="BCR"
SPONSORSHIP_BENEFICIARY_ADDRESS=""
SPONSORSHIP_BENEFICIARY_STREET=""
SPONSORSHIP_BENEFICIARY_STREET_NUMBER=""
SPONSORSHIP_BENEFICIARY_CITY=""
SPONSORSHIP_BENEFICIARY_COUNTY=""
SPONSORSHIP_BENEFICIARY_POSTAL_CODE=""
SPONSORSHIP_BENEFICIARY_REPRESENTATIVE=""
SPONSORSHIP_BENEFICIARY_REPRESENTATIVE_ROLE="Presedinte"
# true only when the association is confirmed in the ANAF fiscal deductions registry
BENEFICIARY_ANAF_REGISTRY_CONFIRMED="false"
FORM_177_FISCAL_YEAR="2025"
NEXT_PUBLIC_FORM_177_FISCAL_YEAR="2025"
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
