# Local Prisma CLI / sqlite file (used by `prisma generate` and `prisma db push`)
DATABASE_URL="file:./dev.db"

# Turso (libSQL) — required on Vercel
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=""

# Vercel Blob — injected automatically when a Blob store is connected
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Google Analytics 4 measurement ID (gtag.js)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-CW42394DCZ"
CRON_SECRET=""

# Admin account (used by `npm run db:seed` and `npm run db:sync-admin`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL for auth callbacks (defaults to NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL="http://localhost:3000"

# Resend — required for verification & password-reset emails
# Get a key from https://resend.com (starts with re_)
RESEND_API_KEY=""
# Must use a verified domain in Resend, e.g.:
# EMAIL_FROM="Visuri pe hartie <noreply@your-verified-domain.ro>"
EMAIL_FROM=""
CONTACT_EMAIL="contact@visuripehartie.ro"

NETOPIA_SIGNATURE=""
NETOPIA_PUBLIC_KEY=""
NETOPIA_PRIVATE_KEY=""
NETOPIA_SANDBOX="true"

NEXT_PUBLIC_ASSOCIATION_CUI="55406686"
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
