generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(uuid())
  // Auth ID (Supabase UID or internal ID)
  authId        String   @unique
  email         String   @unique
  role          String   @default("DONOR") // ADMIN, PARTNER, DONOR
  firstName     String?
  lastName      String?
  
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authId])
}

model Institution {
  id             String   @id @default(uuid())
  name           String   // Private name, only seen by Admin/Partner
  cui            String   @unique
  verified       Boolean  @default(false)
  
  county         String   // Public info e.g. "Vaslui"
  city           String
  addressPrivate String?  // MVP: Private address for shipping/pickup internal usage
  contactName    String?
  contactEmail   String?
  
  users          Profile[]
  scrisori       Scrisoare[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Scrisoare {
  id              String          @id @default(uuid())
  publicCode      String          @unique // e.g. "A24-BUC"
  slug            String          @unique @default(cuid()) 
  
  childFirstName  String
  childAge        Int
  childGender     String?
  childStory      String?         
  
  // New fields for Partner Portal MVP
  items           String?         // JSON string or comma list for MVP. Ideally normalized relation but let's keep it simple string for Seed compat? 
                                  // Prompt asks for items 1-5 with estimatedValue. 
                                  // Let's store as JSON string: [{name, size, value}, ...]
  
  originalImgUrl  String          
  wishList        String          // Keeping for backward compat/simple display
  
  category        String          @default("ALTCEVA")

  targetAmount    Decimal
  collectedAmount Decimal         @default(0)
  
  status          String          @default("NOU") 
                 // Public Status: NOU, ACTIV (Public), FINANTAT, IN_ACHIZITIE, LIVRAT, ANULAT

  moderationStatus String         @default("DRAFT") 
                 // DRAFT, SUBMITTED, APPROVED, REJECTED
  rejectionReason String?
  
  childLastName   String          
  childCnpHash    String?         
  
  institution     Institution     @relation(fields: [institutionId], references: [id])
  institutionId   String
  
  donations       Donation[]
  reservations    Reservation[]
  proofs          ProofMedia[]
  fulfillmentClaims FulfillmentClaim[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([moderationStatus]) // New index
  @@index([institutionId])
  @@index([category])
  @@index([slug])
}

model Donation {
  id                   String         @id @default(uuid())
  stripePaymentIntentId String?       @unique
  stripeSessionId      String?        @unique
  amount               Decimal
  donorEmail           String
  donorName            String?
  isAnonymous          Boolean        @default(false)
  status               String         @default("SUCCEEDED")
  
  scrisoare            Scrisoare      @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String
  createdAt            DateTime       @default(now())

  @@index([scrisoareId])
}

model Reservation {
  id                   String   @id @default(uuid())
  stripePaymentIntentId String? @unique
  stripeSessionId      String?  @unique
  amount               Decimal
  expiresAt            DateTime
  status               String   @default("PENDING") 
  
  scrisoare            Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String

  createdAt            DateTime @default(now())

  @@index([expiresAt])
  @@index([scrisoareId])
}

model ProofMedia {
  id          String      @id @default(uuid())
  url         String
  type        String      
  status      String      @default("PENDING")
  scrisoare   Scrisoare   @relation(fields: [scrisoareId], references: [id])
  scrisoareId String
  createdAt   DateTime    @default(now())
}

model FulfillmentClaim {
  id          String    @id @default(uuid())
  status      String    @default("PENDING") 
  expiresAt   DateTime
  donorEmail  String?
  awbProvider String?
  awbNumber   String?
  awbFileUrl  String?
  notes       String?
  scrisoare   Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scrisoareId])
  @@index([status])
}
