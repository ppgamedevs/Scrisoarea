generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(uuid())
  authId        String   @unique
  email         String   @unique
  role          String   @default("DONOR")
  firstName     String?
  lastName      String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([authId])
}

model Institution {
  id             String   @id @default(uuid())
  // Internal/Legal
  name           String   
  cui            String   @unique
  
  // Public Profile
  slug             String?  @unique
  publicName       String?  // If null, fallback to 'name'
  descriptionPublic String?
  logoUrl          String?
  website          String?

  verified       Boolean  @default(false)
  
  county         String   
  city           String
  addressPrivate String?  
  contactName    String?
  contactEmail   String?
  
  users          Profile[]
  scrisori       Scrisoare[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Campaign {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  descriptionShort String?
  startsAt         DateTime
  endsAt           DateTime?
  status           String   @default("DRAFT")
  category         String?  
  scrisori         Scrisoare[]
  matchingRules    MatchingRule[]
  createdAt        DateTime @default(now())
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  website     String?
  logoUrl     String?
  matchingRules MatchingRule[]
  donations     Donation[]
  createdAt   DateTime @default(now())
}

model MatchingRule {
  id                  String   @id @default(uuid())
  sponsor             Sponsor  @relation(fields: [sponsorId], references: [id])
  sponsorId           String
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  campaignId          String?
  matchType           String   @default("PERCENT_100") 
  maxMatchTotal       Decimal 
  maxMatchPerDonation Decimal? 
  currentMatchTotal   Decimal  @default(0) 
  active              Boolean  @default(true)
  startsAt            DateTime
  endsAt              DateTime?
  donations           Donation[]
  createdAt           DateTime @default(now())
  @@index([sponsorId])
  @@index([campaignId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Scrisoare {
  id              String          @id @default(uuid())
  publicCode      String          @unique 
  slug            String          @unique @default(cuid()) 
  
  childFirstName  String
  childAge        Int
  childGender     String?
  childStory      String?         
  items           String?         
  originalImgUrl  String          
  mediaType       MediaType       @default(IMAGE)
  wishList        String          
  category        String          @default("ALTCEVA")

  targetAmount    Decimal
  collectedAmount Decimal         @default(0)
  
  status          String          @default("NOU") 
  moderationStatus String         @default("DRAFT") 
  rejectionReason String?
  proofApproved   Boolean         @default(false) 
  
  childLastName   String          
  childCnpHash    String?         
  
  institution     Institution     @relation(fields: [institutionId], references: [id])
  institutionId   String

  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  campaignId      String?
  
  donations       Donation[]
  reservations    Reservation[]
  proofs          ProofMedia[]
  fulfillmentClaims FulfillmentClaim[]
  updates         Update[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([moderationStatus]) 
  @@index([institutionId])
  @@index([category])
  @@index([slug])
  @@index([campaignId])
}

model Donation {
  id                   String         @id @default(uuid())
  stripePaymentIntentId String?       @unique
  stripeSessionId      String?        @unique
  amount               Decimal 
  donorEmail           String
  donorName            String?
  isAnonymous          Boolean        @default(false)
  status               String         @default("SUCCEEDED")
  matchedAmount        Decimal        @default(0)
  totalCreditedAmount  Decimal        @default(0) 
  sponsor              Sponsor?       @relation(fields: [sponsorId], references: [id])
  sponsorId            String?
  matchingRule         MatchingRule?  @relation(fields: [matchingRuleId], references: [id])
  matchingRuleId       String?
  scrisoare            Scrisoare      @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String
  createdAt            DateTime       @default(now())
  @@index([scrisoareId])
  @@index([sponsorId])
}

model Reservation {
  id                   String   @id @default(uuid())
  stripePaymentIntentId String? @unique
  stripeSessionId      String?  @unique
  amount               Decimal
  expiresAt            DateTime
  status               String   @default("PENDING") 
  scrisoare            Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String
  createdAt            DateTime @default(now())
  @@index([expiresAt])
  @@index([scrisoareId])
}

model ProofMedia {
  id            String      @id @default(uuid())
  url           String
  type          String      
  thumbnailUrl  String?
  moderationStatus String   @default("PENDING") 
  rejectReason     String?
  scrisoare     Scrisoare   @relation(fields: [scrisoareId], references: [id])
  scrisoareId   String
  createdAt     DateTime    @default(now())
}

model FulfillmentClaim {
  id          String    @id @default(uuid())
  status      String    @default("PENDING") 
  expiresAt   DateTime
  donorEmail  String?
  awbProvider String?
  awbNumber   String?
  awbFileUrl  String?
  notes       String?
  scrisoare   Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([scrisoareId])
  @@index([status])
}

model ActionLog {
  id          String   @id @default(uuid())
  actorType   String   
  actorId     String
  actionType  String   
  targetType  String   
  targetId    String
  metadata    String?  
  createdAt   DateTime @default(now())
  @@index([actionType])
  @@index([actorId])
  @@index([targetId])
}

model Update {
  id          String    @id @default(uuid())
  title       String    
  body        String    
  type        String    
  isPublic    Boolean   @default(true)
  scrisoare   Scrisoare? @relation(fields: [scrisoareId], references: [id])
  scrisoareId String?
  createdBy   String?   
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([type])
  @@index([scrisoareId])
  @@index([createdAt])
}

enum RedirectionType {
  INDIVIDUAL_230
  COMPANY_177
}

enum RedirectionStatus {
  DRAFT
  SUBMITTED
  READY_FOR_ANAF
  FILED
  REJECTED
}

model TaxRedirectionRequest {
  id          String            @id @default(uuid())
  type        RedirectionType
  status      RedirectionStatus @default(DRAFT)
  year        Int

  // Common Contact
  email       String
  phone       String?
  consentTerms Boolean          @default(false)
  consentPrivacy Boolean        @default(false)

  // Individual Form 230
  firstName   String?
  lastName    String?
  cnp         String?           // Ideally encrypted or hashed in code before storing if strictly needed, but for MVP storing plain (or simple encrypt) is common if DB is secure.
  county      String?
  city        String?
  address     String?
  
  // Company Form 177
  companyName String?
  cui         String?
  regCom      String?
  contactName String?           // Representative Name
  amountRON   Decimal?

  // Assets
  signatureUrl String?          // S3/Blob URL or Base64 (if small)
  pdfUrl       String?          // Generated Form 230 or Form 177
  contractUrl  String?          // Sponsorship Contract for 177

  anafNotes    String?          // Admin internal notes

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([type])
  @@index([status])
  @@index([year])
  @@index([email])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
