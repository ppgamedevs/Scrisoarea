generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(uuid())
  authId        String   @unique
  email         String   @unique
  role          String   @default("DONOR")
  firstName     String?
  lastName      String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([authId])
}

model Institution {
  id             String   @id @default(uuid())
  name           String   
  cui            String   @unique
  verified       Boolean  @default(false)
  county         String   
  city           String
  addressPrivate String?  
  contactName    String?
  contactEmail   String?
  users          Profile[]
  scrisori       Scrisoare[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Campaign {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  descriptionShort String?
  startsAt         DateTime
  endsAt           DateTime?
  status           String   @default("DRAFT") // DRAFT, ACTIVE, ENDED
  category         String?  // Optional filter by category
  
  scrisori         Scrisoare[]
  matchingRules    MatchingRule[]
  
  createdAt        DateTime @default(now())
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  website     String?
  logoUrl     String?
  
  matchingRules MatchingRule[]
  donations     Donation[]
  
  createdAt   DateTime @default(now())
}

model MatchingRule {
  id                  String   @id @default(uuid())
  sponsor             Sponsor  @relation(fields: [sponsorId], references: [id])
  sponsorId           String
  
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  campaignId          String?
  
  matchType           String   @default("PERCENT_100") // PERCENT_100, PERCENT_50, FIXED_CAP
  maxMatchTotal       Decimal // Total Budget
  maxMatchPerDonation Decimal? // Cap per tx
  currentMatchTotal   Decimal  @default(0) // Used so far
  
  active              Boolean  @default(true)
  startsAt            DateTime
  endsAt              DateTime?
  
  donations           Donation[]

  createdAt           DateTime @default(now())
  @@index([sponsorId])
  @@index([campaignId])
}

model Scrisoare {
  id              String          @id @default(uuid())
  publicCode      String          @unique 
  slug            String          @unique @default(cuid()) 
  
  childFirstName  String
  childAge        Int
  childGender     String?
  childStory      String?         
  
  items           String?         
  originalImgUrl  String          
  wishList        String          
  category        String          @default("ALTCEVA")

  targetAmount    Decimal
  collectedAmount Decimal         @default(0)
  
  status          String          @default("NOU") 
  moderationStatus String         @default("DRAFT") 
  rejectionReason String?

  proofApproved   Boolean         @default(false) 
  
  childLastName   String          
  childCnpHash    String?         
  
  institution     Institution     @relation(fields: [institutionId], references: [id])
  institutionId   String

  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  campaignId      String?
  
  donations       Donation[]
  reservations    Reservation[]
  proofs          ProofMedia[]
  fulfillmentClaims FulfillmentClaim[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([moderationStatus]) 
  @@index([institutionId])
  @@index([category])
  @@index([slug])
  @@index([campaignId])
}

model Donation {
  id                   String         @id @default(uuid())
  stripePaymentIntentId String?       @unique
  stripeSessionId      String?        @unique
  
  amount               Decimal // User paid amount
  donorEmail           String
  donorName            String?
  isAnonymous          Boolean        @default(false)
  status               String         @default("SUCCEEDED")
  
  // Matching Fields
  matchedAmount        Decimal        @default(0)
  totalCreditedAmount  Decimal        @default(0) // amount + matchedAmount
  
  sponsor              Sponsor?       @relation(fields: [sponsorId], references: [id])
  sponsorId            String?
  
  matchingRule         MatchingRule?  @relation(fields: [matchingRuleId], references: [id])
  matchingRuleId       String?

  scrisoare            Scrisoare      @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String
  createdAt            DateTime       @default(now())
  @@index([scrisoareId])
  @@index([sponsorId])
}

model Reservation {
  id                   String   @id @default(uuid())
  stripePaymentIntentId String? @unique
  stripeSessionId      String?  @unique
  amount               Decimal
  expiresAt            DateTime
  status               String   @default("PENDING") 
  scrisoare            Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String
  createdAt            DateTime @default(now())
  @@index([expiresAt])
  @@index([scrisoareId])
}

model ProofMedia {
  id            String      @id @default(uuid())
  url           String
  type          String      
  thumbnailUrl  String?
  moderationStatus String   @default("PENDING") 
  rejectReason     String?
  scrisoare     Scrisoare   @relation(fields: [scrisoareId], references: [id])
  scrisoareId   String
  createdAt     DateTime    @default(now())
}

model FulfillmentClaim {
  id          String    @id @default(uuid())
  status      String    @default("PENDING") 
  expiresAt   DateTime
  donorEmail  String?
  awbProvider String?
  awbNumber   String?
  awbFileUrl  String?
  notes       String?
  scrisoare   Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([scrisoareId])
  @@index([status])
}
