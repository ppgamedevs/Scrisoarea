generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  authId    String   @unique
  email     String   @unique
  role      String   @default("DONOR")
  firstName String?
  lastName  String?
  
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  cui         String   @unique
  verified    Boolean  @default(false)
  county      String   
  city        String
  
  users     Profile[]
  scrisori  Scrisoare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scrisoare {
  id              String          @id @default(uuid())
  publicCode      String          @unique
  
  childFirstName  String
  childAge        Int
  childGender     String?
  childStory      String?         
  originalImgUrl  String          
  wishList        String          
  
  category        String          @default("ALTCEVA")

  targetAmount    Decimal
  collectedAmount Decimal         @default(0)
  
  status          String          @default("NOU")
  rejectionReason String?
  
  childLastName   String          
  childCnpHash    String?         
  
  institution     Institution     @relation(fields: [institutionId], references: [id])
  institutionId   String
  
  donations       Donation[]
  reservations    Reservation[]
  proofs          ProofMedia[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([institutionId])
  @@index([category])
}

model Donation {
  id                   String         @id @default(uuid())
  stripePaymentIntentId String?       @unique
  stripeSessionId      String?        @unique
  amount               Decimal
  donorEmail           String
  donorName            String?
  isAnonymous          Boolean        @default(false)
  
  status               String         @default("SUCCEEDED")
  
  scrisoare            Scrisoare      @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String

  createdAt            DateTime       @default(now())

  @@index([scrisoareId])
}

model Reservation {
  id                   String   @id @default(uuid())
  stripePaymentIntentId String? @unique
  stripeSessionId      String?  @unique
  amount               Decimal
  expiresAt            DateTime
  status               String   @default("PENDING") // PENDING, CONSUMED, EXPIRED, CANCELLED
  
  scrisoare            Scrisoare @relation(fields: [scrisoareId], references: [id])
  scrisoareId          String

  createdAt            DateTime @default(now())

  @@index([expiresAt])
  @@index([scrisoareId])
  @@index([status])
}

model ProofMedia {
  id          String      @id @default(uuid())
  url         String
  type        String      
  status      String      @default("PENDING")
  
  scrisoare   Scrisoare   @relation(fields: [scrisoareId], references: [id])
  scrisoareId String

  createdAt   DateTime    @default(now())
}
